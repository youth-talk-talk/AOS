# TaskMaster AI - Exclude everything except .txt files
.taskmaster/config.json         # AI model configuration (contains API preferences)
.taskmaster/reports/            # Analysis reports
.taskmaster/cache/              # Cache files
.taskmaster/.temp/              # Temporary files
.taskmaster/logs/               # Log files
.taskmaster/tasks/*/tasks.json  # Project-specific task JSON files
.taskmaster/tasks/*/*.md        # Individual task files (markdown)

# Keep only these TaskMaster files in git:
# .taskmaster/docs/*_prd.txt     # PRD files (e.g., api_test_prd.txt)
# .taskmaster/tasks/*/task_*.txt # Project-specific task text files
# .taskmaster/templates/*.txt    # Text template files

